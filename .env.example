APP_ENV=development
LOG_LEVEL=INFO

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL (native Windows install) — replace password
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_job_agent
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/ai_job_agent

# Redis (native Windows install or Memurai / Redis for Windows)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

JWT_SECRET=change-me-in-production-use-long-secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM — Ollama running natively on Windows
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Optional paid providers
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Relative to backend/ when left empty/default; override if needed
# UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
